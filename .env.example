AIC_MODE=mock
AIC_AGENT_ENABLED=true
AIC_AGENT_DEFAULT_PROVIDER=auto
AIC_AGENT_TIMEOUT_S=12
AIC_AGENT_ALLOW_MODEL_OVERRIDE=true

# Add any subset of these keys. The UI only lists providers that are ready.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=

# Optional model overrides
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_QUALITY_MODEL=openai/gpt-oss-120b
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_QUALITY_MODEL=gpt-5
GEMINI_FAST_MODEL=gemini-3.5-flash
GEMINI_QUALITY_MODEL=gemini-3.5-pro
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_QUALITY_MODEL=claude-sonnet-4-5
OPENROUTER_FAST_MODEL=openrouter/auto
OPENROUTER_QUALITY_MODEL=openrouter/auto
MISTRAL_FAST_MODEL=mistral-small-latest
MISTRAL_QUALITY_MODEL=mistral-large-latest
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_QUALITY_MODEL=deepseek-v4-pro

# Local OpenAI-compatible servers
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
VLLM_ENABLED=false
VLLM_BASE_URL=http://127.0.0.1:8001/v1

# One custom OpenAI-compatible endpoint
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_FAST_MODEL=custom-fast
CUSTOM_OPENAI_QUALITY_MODEL=custom-quality

# Arbitrary extra OpenAI-compatible providers as a JSON list.
AIC_OPENAI_COMPAT_PROVIDERS_JSON=[]
