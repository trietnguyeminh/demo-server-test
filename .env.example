# Run immediately with deterministic demo data
AIC_MODE=mock
AIC_HOST=0.0.0.0
AIC_PORT=8000
AIC_CORS_ORIGINS=*

# Switch to real Kaggle artifacts
# AIC_MODE=artifact
# AIC_VISUAL_MANIFEST=/kaggle/input/notebooks/nguyenminhtric/01-note/aic2025_full_build/artifacts/visual_index/visual_index_manifest.json
# AIC_OCR_SQLITE=/kaggle/input/notebooks/yixuanisthebest/02-note/aic2025_full_build/artifacts/ocr_index/ocr_index.sqlite
# AIC_MODEL_DIR=/kaggle/input/notebooks/nguyenminhtric/00-note/aic2025_full_build/artifacts/weights/siglip2_so400m_patch14_384
# AIC_DATASET_ROOT=/kaggle/input/datasets/nguynnc/aic2025
# AIC_PROJECT_ROOTS=/kaggle/input/notebooks/nguyenminhtric/01-note/aic2025_full_build,/kaggle/input/notebooks/yixuanisthebest/02-note/aic2025_full_build
# AIC_ASR_SQLITE=/kaggle/input/.../asr.sqlite


# External interactive agent (key remains on backend only)
AIC_AGENT_ENABLED=true
AIC_AGENT_PROVIDER=groq
GROQ_API_KEY=replace-in-kaggle-secret-not-in-github
AIC_AGENT_BASE_URL=https://api.groq.com/openai/v1
AIC_AGENT_FAST_MODEL=openai/gpt-oss-20b
AIC_AGENT_QUALITY_MODEL=openai/gpt-oss-120b
AIC_AGENT_TIMEOUT_S=12
AIC_AGENT_MAX_HISTORY=8
AIC_AGENT_SESSION_TTL_S=1800
AIC_AGENT_MAX_EVIDENCE_HITS=8
AIC_AGENT_SERVICE_TIER=on_demand
